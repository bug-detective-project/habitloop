@@ -0,0 +1,25 @@
+import { screen, waitFor, within } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { describe, expect, it } from 'vitest';
+import { mockApi } from '../test/mockApi.ts';
+import { card, renderApp } from '../test/renderApp.tsx';
+
+describe('marking an earlier day', () => {
+  it('makes the streak longer when the day fills the gap before today', async () => {
+    mockApi({
+      habits: [{ id: 2, name: 'Read 10 pages', weeklyGoal: 5, startedOn: '2026-03-01', days: ['2026-03-14', '2026-03-15', '2026-03-16', '2026-03-18'] }],
+    });
+    await renderApp();
+    expect(within(card(2)).getByTestId('streak')).toHaveTextContent('1 day in a row');
+
+    // The week of the history (its first tab) is where an earlier day is marked; the card is on Today.
+    await userEvent.click(screen.getByRole('button', { name: 'History' }));
+    const week = await screen.findByTestId('week-table');
+    await userEvent.click(await within(week).findByRole('button', { name: 'Read 10 pages, Tuesday, March 17' }));
+    await userEvent.click(screen.getByRole('button', { name: 'Today' }));
+
+    await waitFor(() => {
+      expect(within(card(2)).getByTestId('streak')).toHaveTextContent('5 days in a row');
+    });
+  });
+});
diff --git a/client/src/streak.order.test.ts b/client/src/streak.order.test.ts
new file mode 100644
index 0000000..b61af69
--- /dev/null
+++ b/client/src/streak.order.test.ts
@@ -0,0 +1,20 @@
+import { describe, expect, it } from 'vitest';
+import { currentStreak } from './streak.ts';
+
+const TODAY = '2026-03-18';
+
+describe('currentStreak with days in any order', () => {
+  it('counts a day that was marked after the newer ones', () => {
+    // Yesterday was marked last, so it comes after today in the list.
+    expect(currentStreak(['2026-03-15', '2026-03-16', '2026-03-18', '2026-03-17'], TODAY)).toBe(4);
+  });
+
+  it('counts the same streak however the days are ordered', () => {
+    expect(currentStreak(['2026-03-18', '2026-03-16', '2026-03-17'], TODAY)).toBe(3);
+    expect(currentStreak(['2026-03-17', '2026-03-16', '2026-03-10'], TODAY)).toBe(2);
+  });
+
+  it('counts a day once when it appears twice', () => {
+    expect(currentStreak(['2026-03-17', '2026-03-17', '2026-03-18'], TODAY)).toBe(2);
+  });
+});
